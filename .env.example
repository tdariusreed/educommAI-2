# All optional. Defaults shown.
LLM_MODE=auto            # auto = use a model if reachable, else answer straight from sources; off = never use a model
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b     # ~2 GB. qwen2.5:1.5b for very tight machines. Any OpenAI-compatible host works too.
LLM_API_KEY=ollama
